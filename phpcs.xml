<?xml version="1.0"?>
<ruleset name="TekstTV Streekomroep Extensions">
    <description>Quality and WordPress coding standards for the TekstTV Streekomroep Extensions plugin.</description>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>
    <arg value="nps"/>

    <file>./teksttv-wp-extensions.php</file>
    <file>./src/</file>
    <file>./tests/</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>

    <ini name="error_reporting" value="E_ALL &amp; ~E_DEPRECATED"/>

    <config name="minimum_wp_version" value="7.0"/>
    <config name="testVersion" value="8.3-"/>

    <rule ref="Generic.Files.EndFileNewline"/>
    <rule ref="PSR12">
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
        <exclude name="PSR12.Files.FileHeader.SpacingAfterBlock"/>
        <exclude name="Generic.Files.LineLength.TooLong"/>
        <exclude name="PSR1.Methods.CamelCapsMethodName.NotCamelCaps"/>
    </rule>
    <rule ref="PHPCompatibilityWP"/>
    <rule ref="Squiz.Strings.DoubleQuoteUsage"/>
    <rule ref="WordPress-Docs">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.Security"/>
    <rule ref="WordPress.DB">
        <exclude-pattern>tests/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <exclude-pattern>tests/*</exclude-pattern>
        <properties>
            <property name="prefixes" type="array">
                <element value="teksttv_wp_extensions"/>
                <element value="TEKSTTV_WP_EXTENSIONS"/>
                <element value="ZuidWest\TekstTVExtensions"/>
            </property>
        </properties>
    </rule>
    <rule ref="WordPress.PHP">
        <exclude name="WordPress.PHP.YodaConditions"/>
        <exclude name="WordPress.PHP.POSIXFunctions"/>
    </rule>
</ruleset>
