{
    "name": "oszuidwest/teksttv-wp-extensions",
    "description": "Streekomroep ticker extensions for the TekstTV WordPress plugin",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "keywords": ["wordpress", "plugin", "teksttv", "ticker", "radio", "television"],
    "authors": [
        {
            "name": "Streekomroep ZuidWest",
            "homepage": "https://www.zuidwesttv.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/oszuidwest/teksttv-wp-extensions/issues",
        "source": "https://github.com/oszuidwest/teksttv-wp-extensions"
    },
    "autoload": {
        "psr-4": {
            "ZuidWest\\TekstTVExtensions\\": "src/"
        }
    },
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "autoload-dev": {
        "psr-4": {
            "ZuidWest\\TekstTVExtensions\\Tests\\Unit\\": "tests/Unit/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=1G",
        "check": "phpcs",
        "contract": "php tests/contract.php",
        "quality": [
            "@check",
            "@analyse",
            "@test"
        ],
        "security": "composer audit --locked --no-interaction",
        "test": "phpunit"
    }
}
